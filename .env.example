# Copy to .env in the repository root. Never commit the real file.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitplay?schema=public"
AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"
DEMO_PASSWORD="fitplay-demo"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_REALTIME_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_ALLOW_SHORT_SESSIONS="true"
REALTIME_URL="http://127.0.0.1:3001"
REALTIME_PORT="3001"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ALLOW_SHORT_SESSIONS="true"

# Production QR codes refuse localhost. Set the public https origin:
# NEXT_PUBLIC_APP_URL="https://play.example.com"
# REALTIME_URL="https://realtime.example.com"
# CORS_ORIGINS="https://play.example.com"
# ALLOW_SHORT_SESSIONS="false"
# NEXT_PUBLIC_ALLOW_SHORT_SESSIONS="false"

# Public WhatsApp number for pricing, signup, upgrade, and renewal enquiries.
# Digits only, with country code and no plus sign. Links are https://wa.me/<number>?text=...
# Opening a link does not create an account, record a payment, or activate a subscription.
NEXT_PUBLIC_WHATSAPP_NUMBER="919566551345"

# Analytics. Google Analytics stays off when the measurement ID is unset.
# This is a public measurement ID, not an API secret.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXX"

# Optional https dashboard links for /admin/analytics. Not secrets.
# VERCEL_ANALYTICS_DASHBOARD_URL="https://vercel.com/dashboard"
# GA4_DASHBOARD_URL="https://analytics.google.com/analytics/web/"

# Server-only reporting. /admin/analytics shows counts only when a provider's
# variables are all set and that API returns them. Otherwise it links out.
# VERCEL_ANALYTICS_ACCESS_TOKEN=""
# VERCEL_ANALYTICS_PROJECT_ID=""
# VERCEL_ANALYTICS_TEAM_ID=""
# GA4_PROPERTY_ID=""
# GA4_CLIENT_EMAIL=""
# GA4_PRIVATE_KEY=""
