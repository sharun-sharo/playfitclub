<?xml version="1.0" encoding="utf-8"?>
<!-- Same policy as release: system CAs, no cleartext. This shell opens the public site. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
